# Text files are LF, in the repository and in every working tree, on every OS.
# A CRLF file turns every merge with it into a whole-file conflict.
# `python tools/lint/lint.py` fails on a CRLF in a tracked text file.
* text=auto eol=lf

# Windows batch files run under cmd.exe, which wants CRLF in the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.res binary
*.scn binary
*.exr binary
*.hdr binary
*.glb binary
*.zip binary
